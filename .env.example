# Environment Variables for Vercel Contact API (Nodemailer Gmail SMTP)
# 
# Instructions:
# 1. Sign in to your Google Account (skdeepakumar000@gmail.com)
# 2. Go to: https://myaccount.google.com/security
# 3. Enable 2-Step Verification if not already enabled
# 4. Search for "App Passwords" or navigate to: https://myaccount.google.com/apppasswords
# 5. Create a new App Password with name: "Portfolio Website"
# 6. Copy the generated 16-character code (e.g., abcd efgh ijkl mnop)
# 7. In Vercel Project Settings -> Environment Variables, add:
#    - EMAIL_USER = skdeepakumar000@gmail.com
#    - EMAIL_PASS = <your-16-character-app-password-without-spaces>

EMAIL_USER=skdeepakumar000@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
